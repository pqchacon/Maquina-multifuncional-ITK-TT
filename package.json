{
  "name": "gui",
  "private": true,
  "version": "2.0.0",
  "author": {
    "name": "Antonio Chacón",
    "email": "pqchacon@gmail.com"
  },
  "description": "GUI App with Electron + Vite + React",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "electron": "electron .",
    "electron:dev": "concurrently \"vite\" \"electron .\"",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "dist:linux": "npm run build && electron-builder --linux"
  },
  "dependencies": {
    "@serialport/parser-readline": "^13.0.0",
    "@tailwindcss/vite": "^4.1.18",
    "daisyui": "^5.5.18",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-icons": "^5.5.0",
    "react-router-dom": "^7.13.0",
    "serialport": "^13.0.0",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.24",
    "concurrently": "^9.2.1",
    "electron": "^40.4.0",
    "electron-builder": "^26.8.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4"
  },
  "build": {
    "appId": "com.gui.app",
    "productName": "Máquina multifuncional",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      {
        "from": "dist",
        "to": "dist"
      },
      {
        "from": "electron",
        "to": "electron"
      },
      "package.json"
    ],
    "asar": true,
    "npmRebuild": true,
    "buildDependenciesFromSource": true,
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": [
        {
          "target": "deb",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "Utility"
    }
  }
}
